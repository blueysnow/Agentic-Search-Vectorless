# =============================================================================
# Agentic Search Mongo - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# For Docker Compose: MONGODB_URI is overridden to use the container network.

# -- MongoDB --
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Docker Compose (auto-set): mongodb://mongodb:27017/?replicaSet=rs0
# Local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=agentic_search

# -- LLM Provider --
# Options: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Model for document ingestion (tree building, summarization)
LLM_INGESTION_MODEL=claude-haiku-4-5-20251001

# Model for retrieval (query analysis, tree navigation, reasoning)
LLM_RETRIEVAL_MODEL=claude-haiku-4-5-20251001

# API Keys
# REQUIRED: Anthropic API key (default provider)
ANTHROPIC_API_KEY=sk-ant-...
# Optional: OpenAI API key (if you set LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=

# -- Ingestion Configuration --
MAX_PAGES_PER_NODE=10
MAX_TOKENS_PER_NODE=20000
TOC_CHECK_PAGES=20
GENERATE_SUMMARIES=true
GENERATE_KEYWORDS=true

# -- Retrieval Configuration --
MAX_RETRIEVAL_ITERATIONS=5
ATLAS_SEARCH_WEIGHT=0.3
TREE_NAVIGATION_WEIGHT=0.7
TOP_N_CANDIDATES=5

# -- API Server --
PORT=8000
LOG_LEVEL=info

# CORS origins (comma-separated, empty = disabled)
# For local dev with frontend: http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# -- Frontend (Next.js) --
# Set in frontend/.env.local or docker-compose environment
# NEXT_PUBLIC_API_URL=http://localhost:8000
